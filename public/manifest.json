{
  "manifest_version": 3,
  "name": "New Tab Dashboard",
  "version": "0.0.1",
  "description": "A fast, privacy-first new tab dashboard.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "permissions": ["storage", "unlimitedStorage", "alarms", "favicon"],
  "optional_permissions": ["bookmarks", "tabs", "idle"],
  "optional_host_permissions": [
    "https://duckduckgo.com/*",
    "https://www.google.com/*",
    "https://www.bing.com/*",
    "https://search.brave.com/*",
    "https://type.fit/*"
  ]
}
